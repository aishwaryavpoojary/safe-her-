# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional Server-Side Automated SMS Relay (for zero-prompt SMS delivery in web/PWA mode)
# Configure either Twilio credentials OR a custom SMS webhook URL on the server:
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM_NUMBER=""
# DEFAULT_COUNTRY_CODE="+91"
# SMS_WEBHOOK_URL=""
# SMS_WEBHOOK_SECRET=""
